{
  "name": "texion-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter '!@texion/docs' build",
    "typecheck": "pnpm -r --filter '!@texion/docs' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --host 127.0.0.1",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm --filter @texion/docs dev",
    "docs:build": "pnpm --filter @texion/core build && pnpm --filter @texion/react build && pnpm --filter @texion/ocr-tesseract build && pnpm --filter @texion/docs build",
    "docs:test": "playwright test --config playwright.docs.config.ts",
    "docs:typecheck": "pnpm --filter @texion/docs typecheck",
    "benchmark:ocr": "node scripts/benchmark-ocr.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "vite": "^7.3.8",
    "@playwright/test": "^1.65.0",
    "prettier": "^3.5.3",
    "@napi-rs/canvas": "^0.1.80",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "license": "MIT"
}
