{
  "name": "@texion/core",
  "version": "0.1.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unpdf": "1.3.2"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2"
  },
  "license": "MIT",
  "description": "Document parsing, validation, cancellation, and previews for text and file inputs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sirily23/texion.git",
    "directory": "packages/core"
  },
  "homepage": "https://texion.web.app",
  "bugs": {
    "url": "https://github.com/Sirily23/texion/issues"
  },
  "keywords": [
    "documents",
    "parser",
    "pdf",
    "docx",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
