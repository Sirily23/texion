{
  "name": "@texion/ocr-tesseract",
  "version": "0.1.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@texion/core": "workspace:*",
    "tesseract.js": "6.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "description": "Optional local Tesseract OCR workers for Texion PDF extraction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sirily23/texion.git",
    "directory": "packages/ocr-tesseract"
  },
  "homepage": "https://texion.web.app",
  "bugs": {
    "url": "https://github.com/Sirily23/texion/issues"
  },
  "keywords": [
    "ocr",
    "tesseract",
    "pdf",
    "browser",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
